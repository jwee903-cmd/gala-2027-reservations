rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the listed staff sign-in(s) may read or write Gala Dinner data. Everything else is closed.
    function staff() {
      return request.auth != null
        && request.auth.token.email in ['galastaff@example.com'];
    }
    match /gala2027_bookings/{id} { allow read, write: if staff(); }
    match /gala2027_config/{id}   { allow read, write: if staff(); }
  }
}
